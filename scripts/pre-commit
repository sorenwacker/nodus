#!/bin/bash
# Pre-commit hook: runs the CI checks for the parts of the tree a commit touches.
# Install with scripts/setup-hooks.sh; scripts/ci-check.sh runs every check on
# the whole tree. src/__tests__/local-checks-mirror-ci.test.ts fails when this
# hook stops running a check CI runs.

set -e

cd "$(git rev-parse --show-toplevel)"
STAGED=$(git diff --cached --name-only)

echo "Running pre-commit checks..."

echo "Frontend lint..."
npm run lint --silent

echo "Frontend types..."
npm run typecheck

echo "Frontend tests..."
npm test -- --run

if echo "$STAGED" | grep -q "^src-tauri/"; then
    echo "Rust checks..."
    cd src-tauri
    cargo fmt --check || {
        echo "Rust formatting failed. Run 'cargo fmt' to fix."
        exit 1
    }
    # --all-targets so test code is linted too: without it a clippy error in a
    # test file passes this hook and every CI gate
    cargo clippy --all-targets -- -D warnings
    cargo test --quiet
    cd ..
else
    echo "Rust checks skipped: no Rust changes"
fi

if echo "$STAGED" | grep -q "^packages/nodus-mcp-server/"; then
    echo "MCP server build..."
    # tsc type-checks the server files the root suite never imports
    (cd packages/nodus-mcp-server && { [ -d node_modules ] || npm ci; } && npm run build)
else
    echo "MCP server build skipped: no MCP server changes"
fi

echo "Pre-commit checks passed"
